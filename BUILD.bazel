load("@crate//:defs.bzl", "all_crate_deps")
load("@rules_cc//cc:defs.bzl", "cc_test")
load("@rules_rust//cargo:defs.bzl", "cargo_dep_env", "cargo_build_script")
#load("@rules_foreign_cc//foreign_cc:defs.bzl", "cmake")

package(default_visibility = ["//visibility:public"])

CRATE_FEATURES = [
    "auth_pubkey",
    "auth_usrpwd",
    "transport_multilink",
    "transport_compression",
    "transport_quic",
    "transport_serial",
    "transport_tcp",
    "transport_tls",
    "transport_udp",
    "transport_unixsock-stream",
    "transport_ws",
    "shared-memory",
    "unstable"
]

cargo_build_script(
    name = "build_script",
    srcs = glob(["**/*.rs"], exclude=["src/opaque_types/mod.rs"]),
    data = glob(["**"],
        exclude=[
            # These are auto-generated header files.
            "include/zenoh_commons.h",
            "include/zenoh_concrete.h",
            "include/zenoh_configure.h",
            "include/zenoh_macros.h",
            "include/zenoh_opaque.h",
            # These are auto-generated rust files.
            "src/opaque_types/mod.rs",
            # Bazel files
            "BUILD.bazel",
            "MODULE.bazel",
            "MODULE.bazel.lock"
        ]
    ),
    rustc_env = {
        "PROFILE": "debug"
    },
    crate_root = "build.rs",
    crate_features = CRATE_FEATURES,
    deps = all_crate_deps(build = True, normal = True),
)

create_dep_dir(
    name = "dep_dir",
)

cargo_dep_env(
    name = "set_dep_dir",
    src = "set_dep_dir.env",
    out_dir = "dep_dir",
)


