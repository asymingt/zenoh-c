load("@crate//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")
load("@rules_cc//cc:defs.bzl", "cc_test")
load(":rules.bzl", "rust_cbindgen")

package(default_visibility = ["//visibility:public"])

# These are the features wew want to request from the Zenoh build. Note
# that these must match what is in the Cargo.toml file specified in
# the MODULE.bazel file. 

CRATE_FEATURES = [
    "panic",
    "auth_pubkey",
    "auth_usrpwd",
    "transport_multilink",
    "transport_compression",
    "transport_quic",
    "transport_serial",
    "transport_tcp",
    "transport_tls",
    "transport_udp",
    "transport_unixsock-stream",
    "transport_ws",
    "shared-memory",
    "unstable"
]

# Invocation of the original "panic" based build, which will not work in
# rules_rust because we can't expect an action failure as part of a build.
# NOTE: this assumes that the host and target are the same. It will not
# not work for the case where we are cross-compiling.

cargo_build_script(
    name = "build_script",
    srcs = glob(["build-resources/opaque-types/src/lib.rs"]),
    crate_features = ["panic"] + CRATE_FEATURES,
    deps = all_crate_deps(build = True, normal = True),
)

# A simple binary that calculates information about opaque types and then
# produces source code dynamically for a "src/opaque_types/mod.rs" file
# that will be included in the main build. This avoids a nested call to
# cargo from within cargo_build_script, which is not hermetic.

rust_binary(
    name = "opaque_types",
    srcs = ["build-resources/opaque-types/main.rs"],
    crate_features = CRATE_FEATURES,
    deps = all_crate_deps(build = True, normal = True),
)

genrule(
    name = "build_src_opaque_types_mod_rs",
    srcs = [":opaque_types"],
    outs = ["src/opaque_types/mod.rs"],
    cmd = "$(location :opaque_types) > $(location src/opaque_types/mod.rs)",
)

# Now, we run cbindgen to build the C bindings for Zenoh. Note that we don't
# use the build.rs script because it calls cbindgen with insufficient for
# the internal cargo call to be hermetic. So, we use our own set of rules
# that were inspired by: https://github.com/bazelbuild/rules_rust/issues/381

rust_binary(
    name = "cbindgen",
    srcs = ["@crate//:cbindgen__cbindgen"],
    deps = all_crate_deps(build = True, normal = True),
)

rust_cbindgen(
    name = "zenoh_cbindgen",
    config = "cbindgen.toml",
    srcs = glob(["Cargo.toml", "src/**/*.rs"]) + ["src/opaque_types/mod.rs"],
    header = "include/zenoh-cpp.h",
    deps = all_crate_deps(build = True, normal = True),
)

